{
  "name": "swedish-mortgages-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:machine": "node --test --experimental-transform-types tests/stateMachine.test.ts",
    "validate": "node scripts/validate_public_snapshot.mjs && npm run test:machine && tsc --noEmit && vite build"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
